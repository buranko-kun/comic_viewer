{
  "cases": [
    {
      "name": "Cover grid fetches only one page and caches warm browse",
      "url": "https://getcomics.org/",
      "responses": {
        "https://getcomics.org/": {
          "file": "listing.html"
        }
      },
      "expected": {
        "comics": [
          {
            "title": "Alpha #1",
            "cover": "https://images.example/alpha.jpg?fit=400%2C600&ssl=1",
            "size": "43 MB",
            "opensCatalog": true,
            "mirrors": []
          },
          {
            "title": "Beta #2",
            "cover": "https://getcomics.org/covers/beta.jpg",
            "size": "1.2 GB",
            "opensCatalog": true
          }
        ],
        "catalogs": [
          {
            "url": "https://getcomics.org/page/2/"
          },
          {
            "url": "https://getcomics.org/sitemap/"
          }
        ]
      },
      "repeat": 2,
      "requestCount": 1
    },
    {
      "name": "Post extraction preserves signed mirrors and stops at Notes",
      "url": "https://getcomics.org/dc/alpha/",
      "responses": {
        "https://getcomics.org/dc/alpha/": {
          "file": "post.html"
        }
      },
      "expected": {
        "comics": [
          {
            "title": "Alpha #1",
            "cover": "https://getcomics.org/covers/alpha.jpg?size=400&ssl=1",
            "size": "43 MB",
            "mirrors": [
              "https://getcomics.org/dls/AbC+Token:Exact==?key=CaseSensitive%2BValue",
              "https://light.getcomics.info/Folder/Alpha.CBZ?token=KeepCase",
              "https://mega.nz/file/AbCd#KeepThisKey",
              "https://unknown.example/download/Case?signature=ABC",
              "https://unknown.example/download/case?signature=ABC"
            ],
            "hasMirrors": true,
            "opensCatalog": false,
            "canRead": false
          }
        ]
      },
      "requestCount": 1
    },
    {
      "name": "Sitemap excludes menus, categories and duplicates",
      "url": "https://getcomics.org/sitemap/",
      "responses": {
        "https://getcomics.org/sitemap/": {
          "file": "sitemap.html"
        }
      },
      "expected": {
        "comics": [
          {
            "title": "Alpha #1",
            "link": "https://getcomics.org/dc/alpha/",
            "opensCatalog": true
          },
          {
            "title": "Gamma"
          }
        ],
        "catalogs": [
          {
            "url": "https://getcomics.org/sitemap/?lcp_page0=2"
          }
        ]
      },
      "requestCount": 1
    },
    {
      "name": "Last listing page has no next folder",
      "url": "https://getcomics.org/page/2/",
      "responses": {
        "https://getcomics.org/page/2/": {
          "file": "last.html"
        }
      },
      "expected": {
        "comics": [
          {
            "title": "Gamma"
          }
        ],
        "catalogs": []
      }
    },
    {
      "name": "Missing download section is an honest no-mirror post",
      "url": "https://getcomics.org/dc/empty/",
      "responses": {
        "https://getcomics.org/dc/empty/": {
          "file": "no-mirrors.html"
        }
      },
      "expected": {
        "comics": [
          {
            "title": "Post without mirrors",
            "cover": "https://getcomics.org/covers/empty.jpg",
            "size": "875MB",
            "mirrors": [],
            "hasMirrors": false
          }
        ]
      }
    },
    {
      "name": "HTTP rejection is actionable",
      "url": "https://getcomics.org/",
      "responses": {
        "https://getcomics.org/": {
          "status": 403,
          "body": "Forbidden"
        }
      },
      "expectedError": "HTTP 403"
    },
    {
      "name": "Challenge HTML does not look like empty success",
      "url": "https://getcomics.org/",
      "responses": {
        "https://getcomics.org/": {
          "body": "<html><h1>Checking your browser</h1></html>"
        }
      },
      "expectedError": "No GetComics posts found"
    },
    {
      "name": "Wrong source URL rejected before fetching",
      "url": "https://outside.example/",
      "responses": {},
      "expectedError": "must stay on getcomics.org"
    }
  ]
}
